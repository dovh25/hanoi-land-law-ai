# Root local settings; OS environment takes precedence. Never put secrets in VITE_*.
APP_MODE=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/law.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Generate locally with scripts/setup_env.py; this placeholder is intentionally rejected.
JWT_SECRET_KEY=replace-with-a-locally-generated-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
GEMINI_API_KEY=
MODEL=gemini-3.5-flash-lite
ENABLE_LIVE_LLM=false
# Application safety caps, NOT statements about Google free-tier quotas.
# Per-turn is 1 by default; the M2 live test budget is at most 8 calls/day total.
MAX_LLM_CALLS_PER_TURN=1
MAX_LLM_OUTPUT_TOKENS=1024
MAX_LLM_CALLS_PER_DAY=8
LLM_REQUEST_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=0
LLM_USAGE_DB=data/llm-usage.sqlite3
QDRANT_HOST=localhost
QDRANT_PORT=6333
COLLECTION_NAME=laws
VIETNAMESE_COLLECTION_NAME=laws
EMBEDDING_DEVICE=cpu
ALLOW_MODEL_DOWNLOADS=false
ALLOW_REMOTE_MODEL_CODE=false
VIETNAMESE_EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding_v2
RETRIEVAL_MODE=dense
RETRIEVAL_K=10
TOP_K=3
DOCS_ROOT=law_crawler/vbpl_documents
# Context limits; persisted chat is retained until explicitly deleted by its owner.
MAX_HISTORY_MESSAGES=20
MAX_HISTORY_CHARACTERS=20000

# --- Public MVP demo (anonymous, stateless, lexical retrieval) ---
# The demo reads a bundled JSONL artifact and never needs Qdrant, embeddings, or model
# weights. It does not persist conversations and does not use the authenticated chat API.
MVP_ENABLED=true
MVP_DEMO_CORPUS_PATH=backend/resources/mvp_demo_corpus.jsonl
MVP_TOP_K=6
MVP_MIN_SCORE=5.0
MVP_MIN_COVERAGE=0.5
MVP_RATE_LIMIT_PER_MINUTE=6
MVP_RATE_LIMIT_PER_DAY=60
MVP_MAX_MESSAGE_CHARS=1000
MVP_MAX_HISTORY_MESSAGES=6
MVP_MAX_HISTORY_CHARS=4000

# Production CORS: replace with the exact deployed frontend origin(s), e.g.
# CORS_ORIGINS=["https://your-project.pages.dev"]
# Keep the local entries for local development. Never use "*".

# Public browser setting; this value is shipped to clients, so never put a secret here.
# In production set it to the HTTPS backend URL, e.g. https://your-service.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000
